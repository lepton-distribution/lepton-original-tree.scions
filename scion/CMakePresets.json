{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "host",
      "displayName": "Hôte : noyau statique, mklepton, tests hôte",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LEPTON_ISA": "host",
        "LEPTON_KAL_BACKEND": "static"
      }
    },
    {
      "name": "cross",
      "hidden": true,
      "inherits": "base",
      "description": "Cibles Cortex-M (décrites à l'étape 2, validées à l'étape 3) ; mklepton vient du preset host.",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LEPTON_EMBOS_ROOT": "$env{LEPTON_EMBOS_ROOT}",
        "LEPTON_MKLEPTON": "${sourceDir}/../build/host/mklepton"
      }
    },
    {
      "name": "qemu-mps2-an386-embos",
      "displayName": "QEMU mps2-an386 (Cortex-M4F, hard-float), embOS",
      "inherits": "cross",
      "cacheVariables": {
        "LEPTON_ISA": "armv7m",
        "LEPTON_CPU": "cortex-m4f",
        "LEPTON_BOARD": "qemu-mps2-an386",
        "LEPTON_KAL_BACKEND": "embos",
        "LEPTON_FLOAT_ABI": "hard"
      }
    },
    {
      "name": "qemu-mps2-an386-embos-soft",
      "displayName": "QEMU mps2-an386 (Cortex-M4F, soft-float), embOS",
      "description": "Non-régression du chemin sans FPU (libosT7L*) jusqu'aux cœurs M3/M0 (étape 6).",
      "inherits": "qemu-mps2-an386-embos",
      "cacheVariables": {
        "LEPTON_FLOAT_ABI": "soft"
      }
    },
    {
      "name": "qemu-mps2-an386-freertos-soft",
      "displayName": "QEMU mps2-an386 (Cortex-M4F, soft-float), FreeRTOS",
      "description": "Backend KAL FreeRTOS (étape 7, module 7.3), port ARM_CM3 ; même machine que qemu-mps2-an386-embos-soft.",
      "inherits": "qemu-mps2-an386-freertos",
      "cacheVariables": {
        "LEPTON_FLOAT_ABI": "soft"
      }
    },
    {
      "name": "qemu-mps2-an386-freertos",
      "displayName": "QEMU mps2-an386 (Cortex-M4F, hard-float), FreeRTOS",
      "description": "Backend KAL FreeRTOS V11.3.0 (étape 7), même machine que qemu-mps2-an386-embos.",
      "inherits": "cross",
      "cacheVariables": {
        "LEPTON_ISA": "armv7m",
        "LEPTON_CPU": "cortex-m4f",
        "LEPTON_BOARD": "qemu-mps2-an386",
        "LEPTON_KAL_BACKEND": "freertos",
        "LEPTON_FLOAT_ABI": "hard"
      }
    },
    {
      "name": "nucleo-f439zi-embos",
      "displayName": "NUCLEO-F439ZI (Cortex-M4F), embOS",
      "inherits": "cross",
      "cacheVariables": {
        "LEPTON_ISA": "armv7m",
        "LEPTON_CPU": "cortex-m4f",
        "LEPTON_BOARD": "nucleo-f439zi",
        "LEPTON_KAL_BACKEND": "embos"
      }
    },
    {
      "name": "nucleo-f439zi-freertos",
      "displayName": "NUCLEO-F439ZI (Cortex-M4F), FreeRTOS",
      "description": "Backend KAL FreeRTOS V11.3.0 (étape 7, module 7.2), même carte que nucleo-f439zi-embos.",
      "inherits": "nucleo-f439zi-embos",
      "cacheVariables": {
        "LEPTON_KAL_BACKEND": "freertos"
      }
    },
    {
      "name": "qemu-mps2-an500-embos",
      "displayName": "QEMU mps2-an500 (Cortex-M7, hard-float double précision), embOS",
      "inherits": "cross",
      "cacheVariables": {
        "LEPTON_ISA": "armv7m",
        "LEPTON_CPU": "cortex-m7",
        "LEPTON_BOARD": "qemu-mps2-an500",
        "LEPTON_KAL_BACKEND": "embos"
      }
    },
    {
      "name": "qemu-mps2-an500-freertos",
      "displayName": "QEMU mps2-an500 (Cortex-M7, hard-float double précision), FreeRTOS",
      "description": "Backend KAL FreeRTOS (étape 7, module 7.3), même machine que qemu-mps2-an500-embos.",
      "inherits": "qemu-mps2-an500-embos",
      "cacheVariables": {
        "LEPTON_KAL_BACKEND": "freertos"
      }
    },
    {
      "name": "stm32f746g-disco-embos",
      "displayName": "STM32F746G-DISCO (Cortex-M7 r0p1, FPU simple précision), embOS",
      "inherits": "cross",
      "cacheVariables": {
        "LEPTON_ISA": "armv7m",
        "LEPTON_CPU": "cortex-m7",
        "LEPTON_M7_FPU": "sp",
        "LEPTON_BOARD": "stm32f746g-disco",
        "LEPTON_KAL_BACKEND": "embos"
      }
    },
    {
      "name": "stm32f746g-disco-freertos",
      "displayName": "STM32F746G-DISCO (Cortex-M7 r0p1, FPU simple précision), FreeRTOS",
      "description": "Backend KAL FreeRTOS (étape 7, module 7.3), port ARM_CM7/r0p1 ; même carte que stm32f746g-disco-embos.",
      "inherits": "stm32f746g-disco-embos",
      "cacheVariables": {
        "LEPTON_KAL_BACKEND": "freertos"
      }
    },
    {
      "name": "samd21-xplained-pro-embos",
      "displayName": "SAMD21 Xplained Pro (Cortex-M0+, ATSAMD21J18A), embOS",
      "inherits": "cross",
      "cacheVariables": {
        "LEPTON_ISA": "armv6m",
        "LEPTON_CPU": "cortex-m0plus",
        "LEPTON_BOARD": "samd21-xplained-pro",
        "LEPTON_KAL_BACKEND": "embos"
      }
    },
    {
      "name": "samd21-xplained-pro-freertos",
      "displayName": "SAMD21 Xplained Pro (Cortex-M0+, ATSAMD21J18A), FreeRTOS",
      "description": "Backend KAL FreeRTOS (étape 7, module 7.3), port ARM_CM0 ; même carte que samd21-xplained-pro-embos.",
      "inherits": "samd21-xplained-pro-embos",
      "cacheVariables": {
        "LEPTON_KAL_BACKEND": "freertos"
      }
    },
    {
      "name": "nucleo-wl55jc1-embos",
      "displayName": "NUCLEO-WL55JC1 (Cortex-M4 sans FPU, STM32WL55JC), embOS",
      "inherits": "cross",
      "cacheVariables": {
        "LEPTON_ISA": "armv7m",
        "LEPTON_CPU": "cortex-m4f",
        "LEPTON_FLOAT_ABI": "soft",
        "LEPTON_BOARD": "nucleo-wl55jc1",
        "LEPTON_KAL_BACKEND": "embos"
      }
    },
    {
      "name": "nucleo-wl55jc1-freertos",
      "displayName": "NUCLEO-WL55JC1 (Cortex-M4 sans FPU, STM32WL55JC), FreeRTOS",
      "description": "Backend KAL FreeRTOS (étape 7, module 7.3), port ARM_CM3 ; même carte que nucleo-wl55jc1-embos.",
      "inherits": "nucleo-wl55jc1-embos",
      "cacheVariables": {
        "LEPTON_KAL_BACKEND": "freertos"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "qemu-mps2-an386-embos",
