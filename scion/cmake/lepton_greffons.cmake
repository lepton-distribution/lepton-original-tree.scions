# lepton_greffons.cmake — manifestes de greffons lepton-greffon.json (GRF-2, BLD-2, FIC-4, CFG-3).
#
# Un manifeste par greffon, dans son répertoire de destination sous sys/root/src (destination
# vide : sys/root/src lui-même, greffon noyau). La racine scion/ est commune à tous les greffons
# du trunk : un manifeste à cet endroit y entrerait en conflit (scion refuse deux feuilles au même
# chemin). Schéma : schemas/greffon.schema.json de lepton-tools ; CMake ne contrôle que les champs
# qu'il utilise, la validation complète relève de check-jsonschema.
#
# Lecture (toute configuration, à l'inclusion) : découverte dans le trunk, champs obligatoires et
# types contrôlés, FATAL_ERROR citant le fichier. Résultat : LEPTON_GREFFONS (noms) et
# LEPTON_GREFFON_<nom>_<CHAMP>.
#
# Application (presets croisés, lepton_greffons_appliquer) :
# - greffon noyau : ses bibliothèques sont définies par son CMakeLists.txt (BLD-1) ; options de
#   portée publique → lepton_options (tous les greffons dépendent du noyau), privée → sources
#   de kernel, lib, sbin, bin, kernel_demarrage, relevées avant l'ajout de celles des greffons ;
# - autre greffon : fichiers .c et .S des répertoires `sources` (file(GLOB … CONFIGURE_DEPENDS))
#   ajoutés à la bibliothèque `bibliotheque`, créée si absente et alors ajoutée au groupe d'édition
#   de liens (LEPTON_GREFFONS_BIBLIOTHEQUES) ; options de portée privée → sources du greffon,
#   publique → sources du greffon et des greffons qui en dépendent (propriétés de source, visibles
#   dans compile_commands.json).
# Options configurables (`options`) : définition <nom>=<défaut> (booléen : 1 ou 0 ; chaîne entre
# guillemets) dans la portée déclarée ; valeurs de la graine : ENV-8.

set(LEPTON_MANIFESTE_GREFFON lepton-greffon.json)
set(LEPTON_GREFFON_TYPES noyau famille bsp application bibliotheque)

function(_lepton_manifeste_erreur fichier texte)
  message(FATAL_ERROR "manifeste ${fichier} : ${texte}")
endfunction()

# _lepton_json(<sortie> <STRING|ARRAY|OBJECT|NUMBER|BOOLEAN> <json> <fichier> <clé>...)
# Valeur du champ (tableau : liste CMake de ses éléments textuels, l'élément vide devenant « . »,
# chemin du répertoire de destination lui-même) ; champ absent : <sortie> vide et <sortie>_ABSENT
# vrai ; type différent : erreur.
function(_lepton_json sortie type json fichier)
  string(JSON t ERROR_VARIABLE err TYPE "${json}" ${ARGN})
  if(err)
    set(${sortie} "" PARENT_SCOPE)
    set(${sortie}_ABSENT TRUE PARENT_SCOPE)
    return()
  endif()
  list(JOIN ARGN "." champ)
  if(NOT t STREQUAL type)
    _lepton_manifeste_erreur(${fichier} "champ « ${champ} » : ${type} attendu, ${t} trouvé")
  endif()
  if(type STREQUAL "ARRAY")
    set(valeurs)
    string(JSON n LENGTH "${json}" ${ARGN})
    if(n GREATER 0)
      math(EXPR dernier "${n} - 1")
      foreach(i RANGE ${dernier})
        string(JSON ti TYPE "${json}" ${ARGN} ${i})
        if(NOT ti STREQUAL "STRING")
          _lepton_manifeste_erreur(${fichier} "champ « ${champ} » : texte attendu à l'indice ${i}")
        endif()
        string(JSON v GET "${json}" ${ARGN} ${i})
        if(v STREQUAL "")
          set(v .)
        endif()
        list(APPEND valeurs "${v}")
      endforeach()
    endif()
    set(${sortie} "${valeurs}" PARENT_SCOPE)
  else()
    string(JSON v GET "${json}" ${ARGN})
    set(${sortie} "${v}" PARENT_SCOPE)
  endif()
  set(${sortie}_ABSENT FALSE PARENT_SCOPE)
endfunction()

# _lepton_greffon_lire(<fichier>) : lit un manifeste, pose LEPTON_GREFFON_<nom>_* et ajoute le
# nom à LEPTON_GREFFONS (portée de l'appelant).
function(_lepton_greffon_lire fichier)
  # manifeste modifié → reconfiguration (CONFIGURE_DEPENDS du GLOB ne suit que la liste des fichiers)
  set_property(DIRECTORY ${CMAKE_SOURCE_DIR} APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${fichier})
  file(READ ${fichier} json)
  string(JSON t ERROR_VARIABLE err TYPE "${json}")
  if(err OR NOT t STREQUAL "OBJECT")
    _lepton_manifeste_erreur(${fichier} "objet JSON attendu ${err}")
  endif()
  foreach(champ nom type version destination)
    _lepton_json(${champ} STRING "${json}" ${fichier} ${champ})
    if(${champ}_ABSENT)
      _lepton_manifeste_erreur(${fichier} "champ obligatoire « ${champ} » absent")
    endif()
  endforeach()
  if(NOT type IN_LIST LEPTON_GREFFON_TYPES)
    _lepton_manifeste_erreur(${fichier} "type « ${type} » inconnu (${LEPTON_GREFFON_TYPES})")
  endif()
  if(nom IN_LIST LEPTON_GREFFONS)
    _lepton_manifeste_erreur(${fichier}
      "nom « ${nom} » déjà déclaré par ${LEPTON_GREFFON_${nom}_FICHIER}")
  endif()
  get_filename_component(rep ${fichier} DIRECTORY)
  file(RELATIVE_PATH emplacement ${LEPTON_SRC} ${rep})
  if(NOT destination STREQUAL emplacement)
    _lepton_manifeste_erreur(${fichier}
      "destination « ${destination} » différente de l'emplacement du manifeste « ${emplacement} »")
  endif()

  _lepton_json(bibliotheque STRING "${json}" ${fichier} bibliotheque)
  _lepton_json(sources ARRAY "${json}" ${fichier} sources)
  if(NOT type STREQUAL "noyau" AND bibliotheque_ABSENT)
    _lepton_manifeste_erreur(${fichier} "champ obligatoire « bibliotheque » absent")
  endif()
  if(type MATCHES "^(application|bibliotheque)$" AND sources_ABSENT)
    _lepton_manifeste_erreur(${fichier} "champ obligatoire « sources » absent")
  endif()
  _lepton_json(dependances ARRAY "${json}" ${fichier} dependances)
  foreach(portee privee publique)
    _lepton_json(${portee}_definitions ARRAY "${json}" ${fichier} compilation ${portee} definitions)
    _lepton_json(${portee}_drapeaux ARRAY "${json}" ${fichier} compilation ${portee} drapeaux)
  endforeach()

  string(JSON t ERROR_VARIABLE err TYPE "${json}" options)
  if(NOT err)
    if(NOT t STREQUAL "ARRAY")
      _lepton_manifeste_erreur(${fichier} "champ « options » : ARRAY attendu, ${t} trouvé")
    endif()
    string(JSON n LENGTH "${json}" options)
    if(n GREATER 0)
      math(EXPR dernier "${n} - 1")
      foreach(i RANGE ${dernier})
        foreach(champ nom type portee)
          _lepton_json(option_${champ} STRING "${json}" ${fichier} options ${i} ${champ})
          if(option_${champ}_ABSENT)
            _lepton_manifeste_erreur(${fichier} "options[${i}] : champ obligatoire « ${champ} » absent")
          endif()
        endforeach()
        if(option_type STREQUAL "booleen")
          _lepton_json(defaut BOOLEAN "${json}" ${fichier} options ${i} defaut)
          if(NOT defaut_ABSENT)
            if(defaut)
              set(defaut 1)
            else()
              set(defaut 0)
            endif()
          endif()
        elseif(option_type STREQUAL "entier")
          _lepton_json(defaut NUMBER "${json}" ${fichier} options ${i} defaut)
        elseif(option_type MATCHES "^(enumeration|chaine)$")
          _lepton_json(defaut STRING "${json}" ${fichier} options ${i} defaut)
          if(option_type STREQUAL "chaine")
            set(defaut "\"${defaut}\"")
          endif()
        else()
          _lepton_manifeste_erreur(${fichier} "options[${i}] : type « ${option_type} » inconnu")
        endif()
        if(defaut_ABSENT)
          _lepton_manifeste_erreur(${fichier} "options[${i}] : champ obligatoire « defaut » absent")
        endif()
        if(NOT option_portee MATCHES "^(privee|publique)$")
          _lepton_manifeste_erreur(${fichier} "options[${i}] : portée « ${option_portee} » inconnue")
        endif()
        list(APPEND ${option_portee}_definitions "${option_nom}=${defaut}")
      endforeach()
    endif()
  endif()

  set(p LEPTON_GREFFON_${nom})
  set(${p}_FICHIER ${fichier} PARENT_SCOPE)
  set(${p}_TYPE ${type} PARENT_SCOPE)
  set(${p}_VERSION ${version} PARENT_SCOPE)
  set(${p}_DESTINATION "${destination}" PARENT_SCOPE)
  set(${p}_BIBLIOTHEQUE "${bibliotheque}" PARENT_SCOPE)
  set(${p}_SOURCES "${sources}" PARENT_SCOPE)
  set(${p}_DEPENDANCES "${dependances}" PARENT_SCOPE)
  foreach(portee privee publique)
    string(TOUPPER ${portee} P)
    set(${p}_${P}_DEFINITIONS "${${portee}_definitions}" PARENT_SCOPE)
    set(${p}_${P}_DRAPEAUX "${${portee}_drapeaux}" PARENT_SCOPE)
  endforeach()
  set(LEPTON_GREFFONS ${LEPTON_GREFFONS} ${nom} PARENT_SCOPE)
endfunction()

# lepton_greffons_appliquer() : sources et options des greffons (presets croisés) ; pose
# LEPTON_GREFFONS_BIBLIOTHEQUES (bibliothèques créées, à ajouter au groupe d'édition de liens).
function(lepton_greffons_appliquer)
  set(creees)
  foreach(nom IN LISTS LEPTON_GREFFONS)
    set(p LEPTON_GREFFON_${nom})
    if(NOT ${p}_TYPE STREQUAL "noyau")
      continue()
    endif()
    target_compile_definitions(lepton_options INTERFACE ${${p}_PUBLIQUE_DEFINITIONS})
    target_compile_options(lepton_options INTERFACE ${${p}_PUBLIQUE_DRAPEAUX})
    set(fichiers)
    foreach(cible kernel lib sbin bin kernel_demarrage)
      if(TARGET ${cible})
        get_target_property(s ${cible} SOURCES)
        list(APPEND fichiers ${s})
      endif()
    endforeach()
    if(${p}_PRIVEE_DEFINITIONS)
      set_property(SOURCE ${fichiers} APPEND PROPERTY COMPILE_DEFINITIONS ${${p}_PRIVEE_DEFINITIONS})
    endif()
    if(${p}_PRIVEE_DRAPEAUX)
      set_property(SOURCE ${fichiers} APPEND PROPERTY COMPILE_OPTIONS ${${p}_PRIVEE_DRAPEAUX})
    endif()
  endforeach()

  foreach(nom IN LISTS LEPTON_GREFFONS)
    set(p LEPTON_GREFFON_${nom})
    if(${p}_TYPE STREQUAL "noyau")
      continue()
    endif()

    set(fichiers)
    foreach(s IN LISTS ${p}_SOURCES)
      set(rep ${LEPTON_SRC}/${${p}_DESTINATION})
      if(NOT s STREQUAL ".")
        string(APPEND rep /${s})
      endif()
      if(NOT IS_DIRECTORY ${rep})
        _lepton_manifeste_erreur(${${p}_FICHIER} "répertoire de sources absent : ${rep}")
      endif()
      file(GLOB cpp CONFIGURE_DEPENDS ${rep}/*.cpp)
      if(cpp)
        _lepton_manifeste_erreur(${${p}_FICHIER} "sources C++ non prises en charge : ${cpp}")
      endif()
      file(GLOB trouves CONFIGURE_DEPENDS ${rep}/*.c ${rep}/*.S)
      list(SORT trouves)
      list(APPEND fichiers ${trouves})
    endforeach()
    if(NOT fichiers)
      message(STATUS "greffon ${nom} : aucune source")
      continue()
    endif()

    set(bib ${${p}_BIBLIOTHEQUE})
    if(NOT TARGET ${bib})
      add_library(${bib} STATIC)
      target_link_libraries(${bib} PRIVATE lepton_options)
      add_dependencies(${bib} board_mkconf)
      list(APPEND creees ${bib})
    endif()
    target_sources(${bib} PRIVATE ${fichiers})

    # portée : privée et publique du greffon, publique de ses dépendances (hors noyau, déjà dans
    # lepton_options)
    set(definitions ${${p}_PRIVEE_DEFINITIONS} ${${p}_PUBLIQUE_DEFINITIONS})
    set(drapeaux ${${p}_PRIVEE_DRAPEAUX} ${${p}_PUBLIQUE_DRAPEAUX})
    foreach(dep IN LISTS ${p}_DEPENDANCES)
      if(NOT dep IN_LIST LEPTON_GREFFONS)
        _lepton_manifeste_erreur(${${p}_FICHIER} "dépendance « ${dep} » : aucun greffon de ce nom")
      endif()
      if(NOT LEPTON_GREFFON_${dep}_TYPE STREQUAL "noyau")
        list(APPEND definitions ${LEPTON_GREFFON_${dep}_PUBLIQUE_DEFINITIONS})
        list(APPEND drapeaux ${LEPTON_GREFFON_${dep}_PUBLIQUE_DRAPEAUX})
      endif()
    endforeach()
    if(definitions)
      set_property(SOURCE ${fichiers} APPEND PROPERTY COMPILE_DEFINITIONS ${definitions})
    endif()
    if(drapeaux)
      set_property(SOURCE ${fichiers} APPEND PROPERTY COMPILE_OPTIONS ${drapeaux})
    endif()
    message(STATUS "greffon ${nom} : ${bib} (${${p}_SOURCES})")
  endforeach()
  set(LEPTON_GREFFONS_BIBLIOTHEQUES ${creees} PARENT_SCOPE)
endfunction()

# --- lecture -------------------------------------------------------------------------------------
set(LEPTON_GREFFONS)
file(GLOB_RECURSE lepton_manifestes CONFIGURE_DEPENDS ${LEPTON_SRC}/${LEPTON_MANIFESTE_GREFFON})
list(SORT lepton_manifestes)
foreach(f IN LISTS lepton_manifestes)
  _lepton_greffon_lire(${f})
endforeach()
message(STATUS "greffons : ${LEPTON_GREFFONS}")
